#!/bin/bash
# maudebox – launch a maudebox container for a given worktree
#
# Requires the image to already be built via build.sh.
#
# Usage:
#   maudebox [--clean] [--tag TAG] [project-dir] [command...]
#
# Options:
#   --clean   remove the overlay volume for this worktree and exit
#   --tag     image tag to run (default: maudebox)
#
# Examples:
#   maudebox                               # interactive shell in current dir
#   maudebox /path/to/myproject            # interactive shell, specific project
#   maudebox . mvnd verify                 # run a build
#   maudebox . claude                      # start Claude Code
#   maudebox --clean /path/to/myproject    # delete that worktree's overlay volume

set -euo pipefail

IMAGE_NAME="maudebox"
CLEAN=false
MEMORY_FROM=""
EPHEMERAL_NAME=""
EXTRA_MOUNTS=()
CONTAINER_HOME="/root"   # fixed by the entrypoint; ~ on the container side
                         # of a --mount/config spec expands to this
OVERLAY_HOSTS=()         # parallel arrays populated by build_mount_arg for
OVERLAY_TARGETS=()       # each spec that uses mode `overlay`

# XDG Base Directory: config under $XDG_CONFIG_HOME (default ~/.config),
# state already lives under $XDG_STATE_HOME (default ~/.local/state) via
# compute_state_dir below.
MAUDEBOX_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/maudebox/config.toml"

usage() {
    cat <<'EOF'
Usage: maudebox [--clean] [--tag TAG] [project-dir] [command...]
       maudebox new <name> [project-dir] [--path PATH] [--from REV] [--ephemeral]
       maudebox list
       maudebox keep <id-or-name>
       maudebox mount {add SPEC | list | rm SPEC}

Launch a maudebox container for a host project directory. The project (and
its base repo, if it's a jj workspace or git worktree) is bind-mounted at
its host path inside the container so VCS metadata still resolves. Extra
host paths can be exposed via --mount or the user config; any of them can use
mode `overlay` to layer a per-worktree writable upper over a read-only
host lower (typically used for ~/.m2 to isolate Maven snapshots per
worktree without mutating the host cache).

Options:
  --clean              remove every overlay volume tied to this project and exit
  --tag TAG            image tag to run (default: maudebox)
  --memory-from PATH   share Claude's auto-memory dir with another project
                       (host source keyed to PATH, container target unchanged)
  --mount SPEC         add an extra bind mount, where SPEC is
                         HOST_PATH:CONTAINER_PATH[:ro|rw|overlay]
                       Leading `~` on the host side expands to $HOME, on the
                       container side to /root. Mode defaults to rw. Mode
                       `overlay` layers a per-worktree writable upper (Docker
                       volume) over a read-only host lower — repeat with
                       different targets to set up multiple overlays. Mounts
                       can also be declared in
                       $XDG_CONFIG_HOME/maudebox/config.toml (TOML):
                         mounts = [
                             "~/.m2:~/.m2:overlay",
                             "~/.aws:~/.aws:ro",
                         ]
  -h, --help           show this help and exit

Arguments:
  project-dir   host directory to mount (default: current directory)
  command...    command to run inside the container (default: interactive shell)

Subcommands:
  new <name>    create a jj workspace or git worktree from project-dir
                (default: cwd) and launch maudebox on it, sharing the
                parent project's Claude auto-memory dir. The workspace and
                its overlay volume persist after the container exits, just
                like `maudebox <path>`.
                  --path PATH   target path
                                (default: <project>/../<basename>.<name>)
                  --from REV    starting revision
                                (default: jj @-, git HEAD)
                  --ephemeral   tear down the workspace/worktree and its
                                overlay volume when the container exits
                                (use `maudebox-keep` / `maudebox keep` to
                                disarm mid-session)
  list          list every registered maudebox instance (anything with at
                least one overlay volume), showing its container ID if
                running, its running/stopped status, instance name,
                ephemeral status, overlay count, and project path.
  keep <id-or-name>
                for a running ephemeral instance, prevent its workspace and
                Maven overlay from being deleted when the container exits.
                The argument matches the container ID (as shown in `maudebox
                list`), the instance basename (the path's last component), or
                the ephemeral name originally passed to `maudebox new`. From
                inside the container, run `maudebox-keep` instead — same
                effect.
  mount add SPEC
                append a mount spec (HOST:CONTAINER[:ro|rw|overlay]) to
                the user config so it applies to every future invocation.
  mount list    print all mount specs currently configured in the user config.
  mount rm SPEC
                remove a previously-added mount spec from the user config.

Examples:
  maudebox                               # interactive shell in current dir
  maudebox /path/to/myproject            # interactive shell, specific project
  maudebox . mvnd verify                 # run a build
  maudebox . claude                      # start Claude Code
  maudebox --clean /path/to/myproject    # delete that worktree's overlay volume
  maudebox new feature-x                 # new workspace from cwd (kept on exit)
  maudebox new feature-x /path/to/proj   # new workspace from a specific project
  maudebox new feature-x --from main     # start from a specific revision
  maudebox new feature-x --ephemeral     # tear down workspace/overlay on exit
  maudebox list                          # list registered maudebox instances
  maudebox keep feature-x                # don't tear down on exit (running instance)
  maudebox --mount ~/.aws:~/.aws:ro      # bind ~/.aws read-only into the container
  maudebox mount add ~/.m2:~/.m2:overlay # persist a mount in the user config
  maudebox mount list                    # show configured mounts
  maudebox mount rm ~/.m2:~/.m2:overlay  # remove a configured mount
EOF
}

# ── volume / state-dir naming ────────────────────────────────────────────────
# A project key combines the basename (human-readable) with a short hash of
# the full path (collision-proof), e.g. `myproject-a3f8c21b`. Used to scope
# the per-instance state dir for ephemeral runs.
compute_volume_name() {
    local dir="$1"
    local dir_name path_hash
    dir_name="$(basename "$dir")"
    path_hash="$(echo "$dir" | sha256sum | cut -c1-8)"
    echo "maudebox-overlay-${dir_name}-${path_hash}"
}

# Each overlay mount on a project gets its own Docker volume, named with
# the project key plus a short hash of the container target so multiple
# overlays on the same project don't collide.
compute_overlay_volume() {
    local project="$1" target="$2"
    local target_hash
    target_hash="$(echo "$target" | sha256sum | cut -c1-8)"
    echo "$(compute_volume_name "$project")-${target_hash}"
}

# ── per-instance state dir on the host ───────────────────────────────────────
# Keyed by overlay volume name (i.e. by full project path) so it's stable
# across runs of the same worktree. For ephemeral runs the wrapper bind-mounts
# this at /run/maudebox/ so an in-container `maudebox-keep` (or host-side
# `maudebox keep`) can drop a flag the cleanup trap reads after exit.
compute_state_dir() {
    local dir="$1"
    echo "${XDG_STATE_HOME:-$HOME/.local/state}/maudebox/instances/$(compute_volume_name "$dir")"
}

# ── config-file mount parsing ────────────────────────────────────────────────
# Parses a `mounts = [ "...", ... ]` array out of a TOML config and emits one
# spec per line on stdout. Supports the limited subset we actually use:
# double-quoted strings inside the array, comments via `#`, the array spread
# across one line or many. Strings with embedded `]` or `#` are not handled.
parse_toml_mounts() {
    local cfg="$1"
    [ -e "$cfg" ] || return 0
    local in_array=false
    local rest line
    while IFS= read -r line; do
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [ -z "$line" ] && continue

        if ! $in_array; then
            if [[ "$line" =~ ^mounts[[:space:]]*=[[:space:]]*\[(.*)$ ]]; then
                in_array=true
                rest="${BASH_REMATCH[1]}"
            else
                continue
            fi
        else
            rest="$line"
        fi

        if [[ "$rest" == *"]"* ]]; then
            rest="${rest%%]*}"
            in_array=false
        fi
        while [[ "$rest" =~ \"([^\"]*)\" ]]; do
            printf '%s\n' "${BASH_REMATCH[1]}"
            rest="${rest#*\"${BASH_REMATCH[1]}\"}"
        done
    done < "$cfg"
}

# Convert a HOST:CONTAINER[:MODE] spec to a `-v <expanded-host>:<expanded-
# container>:<mode>` pair, expanding leading `~` on the host side to $HOME
# and on the container side to $CONTAINER_HOME. Mode defaults to rw. Output
# goes into the array named in the first arg (bash 3.2-compatible — no
# nameref, just eval-style append).
#
# Mode `overlay` is special: it asks the wrapper to set up a per-worktree
# overlayfs at the container target (lowerdir = the host path, ro;
# upperdir = a Docker volume named per-project + per-target). Multiple
# overlay specs in one invocation are allowed; we collect each into the
# OVERLAY_HOSTS / OVERLAY_TARGETS arrays and the run section materialises
# the corresponding volumes, mounts, and entrypoint env var. The actual
# `-v` flags for non-overlay mounts get appended to the array named in
# the first arg.
build_mount_arg() {
    local out_array="$1" spec="$2"
    local src dst mode
    IFS=':' read -r src dst mode <<<"$spec"
    : "${mode:=rw}"
    [[ "$src" == "~"* ]] && src="$HOME${src:1}"
    [[ "$dst" == "~"* ]] && dst="${CONTAINER_HOME}${dst:1}"

    if [ "$mode" = "overlay" ]; then
        # Reject a duplicate overlay target — overlayfs would refuse to
        # double-mount on the same dir anyway, and silently ignoring the
        # repeat would mask a config error.
        local i
        for ((i=0; i<${#OVERLAY_TARGETS[@]}; i++)); do
            if [ "${OVERLAY_TARGETS[$i]}" = "$dst" ]; then
                echo "Duplicate overlay target: $dst (sources: ${OVERLAY_HOSTS[$i]} and $src)" >&2
                exit 1
            fi
        done
        OVERLAY_HOSTS+=( "$src" )
        OVERLAY_TARGETS+=( "$dst" )
        return
    fi

    eval "${out_array}+=( -v \"\$src:\$dst:\$mode\" )"
}

# ── `maudebox new` ────────────────────────────────────────────────────────────
# Create a jj workspace or git worktree from a source project and run
# maudebox on it. By default the workspace persists after the container
# exits, like `maudebox <path>` does. With --ephemeral, the workspace and
# its overlay volume are torn down on exit. jj is preferred when both .jj
# and .git are present (colocated repos). State for the EXIT trap is held
# in script-scope globals (NEW_*) so the cleanup function can see them
# when bash fires the trap during shell teardown.
NEW_NAME=""; NEW_TARGET=""; NEW_SOURCE=""; NEW_KIND=""; NEW_EPHEMERAL=false

cmd_new() {
    local from_rev=""
    NEW_SOURCE="."

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)   usage; exit 0 ;;
            --path)      NEW_TARGET="$2";    shift 2 ;;
            --from)      from_rev="$2";      shift 2 ;;
            --ephemeral) NEW_EPHEMERAL=true; shift ;;
            -*)          echo "Unknown option: $1" >&2; exit 1 ;;
            *)
                if [ -z "$NEW_NAME" ]; then
                    NEW_NAME="$1"
                elif [ "$NEW_SOURCE" = "." ]; then
                    NEW_SOURCE="$1"
                else
                    echo "Unexpected argument: $1" >&2; exit 1
                fi
                shift
                ;;
        esac
    done

    [ -n "$NEW_NAME" ] || { echo "maudebox new: <name> is required" >&2; exit 1; }

    NEW_SOURCE="$(realpath "$NEW_SOURCE")"
    [ -d "$NEW_SOURCE" ] || { echo "Not a directory: $NEW_SOURCE" >&2; exit 1; }

    if [ -z "$NEW_TARGET" ]; then
        NEW_TARGET="$(dirname "$NEW_SOURCE")/$(basename "$NEW_SOURCE").${NEW_NAME}"
    elif [[ "$NEW_TARGET" != /* ]]; then
        NEW_TARGET="$(pwd)/$NEW_TARGET"
    fi

    [ -e "$NEW_TARGET" ] && { echo "Target path already exists: $NEW_TARGET" >&2; exit 1; }

    if [ -d "$NEW_SOURCE/.jj" ]; then
        NEW_KIND=jj
        echo "Creating jj workspace '$NEW_NAME' at: $NEW_TARGET"
        local jj_args=( workspace add --name "$NEW_NAME" )
        [ -n "$from_rev" ] && jj_args+=( -r "$from_rev" )
        jj_args+=( "$NEW_TARGET" )
        ( cd "$NEW_SOURCE" && jj "${jj_args[@]}" )
    elif [ -e "$NEW_SOURCE/.git" ]; then
        NEW_KIND=git
        local rev="${from_rev:-HEAD}"
        echo "Creating git worktree '$NEW_NAME' at: $NEW_TARGET (branch: $NEW_NAME from $rev)"
        ( cd "$NEW_SOURCE" && git worktree add -b "$NEW_NAME" "$NEW_TARGET" "$rev" )
    else
        echo "Not a jj or git repo: $NEW_SOURCE" >&2
        exit 1
    fi

    local inner_args=( --tag "$IMAGE_NAME" --memory-from "$NEW_SOURCE" )
    # Forward --mount specs collected on the outer command line. The inner
    # invocation re-reads the user config itself, so config-file mounts
    # aren't forwarded here (would otherwise duplicate).
    local spec
    for spec in "${EXTRA_MOUNTS[@]+"${EXTRA_MOUNTS[@]}"}"; do
        inner_args+=( --mount "$spec" )
    done
    if $NEW_EPHEMERAL; then
        # Pass --ephemeral-name only on actually-ephemeral runs so the inner
        # invocation labels the container as such and bind-mounts the state
        # dir for the keep mechanism. Non-ephemeral `maudebox new` looks
        # exactly like `maudebox <path>` from the inner side.
        trap _maudebox_new_cleanup EXIT
        inner_args+=( --ephemeral-name "$NEW_NAME" )
    fi

    local rc=0
    "$0" "${inner_args[@]}" "$NEW_TARGET" || rc=$?
    exit $rc
}

_maudebox_new_cleanup() {
    local rc=$?
    set +e   # best-effort cleanup

    local state_dir
    state_dir="$(compute_state_dir "$NEW_TARGET")"

    # The user (in-container `maudebox-keep` or host `maudebox keep`) can drop
    # a `keep` file in the state dir to disarm cleanup mid-session. Honour it
    # by leaving the workspace and overlay in place — but still drop the now-
    # stale state dir so a future `maudebox` invocation against this same path
    # starts fresh (it's no longer ephemeral after this point).
    if [ -e "$state_dir/keep" ]; then
        echo "Keep flag set; preserving $NEW_KIND workspace at: $NEW_TARGET"
        rm -rf "$state_dir"
        return $rc
    fi

    echo "Cleaning up ephemeral $NEW_KIND workspace at: $NEW_TARGET"
    case "$NEW_KIND" in
        jj)
            ( cd "$NEW_SOURCE" && jj workspace forget "$NEW_NAME" )
            rm -rf "$NEW_TARGET"
            ;;
        git)
            ( cd "$NEW_SOURCE" && git worktree remove --force "$NEW_TARGET" )
            ( cd "$NEW_SOURCE" && git branch -D "$NEW_NAME" )
            ;;
    esac
    local volume
    volume="$(compute_volume_name "$NEW_TARGET")"
    docker volume rm "$volume" >/dev/null 2>&1
    rm -rf "$state_dir"
    return $rc
}

# ── `maudebox list` ──────────────────────────────────────────────────────────
# An "instance" is a project: anything currently running OR with at least
# one overlay volume on disk shows up. We collect both, union the project
# keys, and emit one row per unique project — preferring volume labels for
# metadata (durable, present even when stopped) and falling back to
# container labels when no volume exists yet.
#
# An ephemeral instance whose keep flag is set is shown as non-ephemeral,
# since at that point it'll persist after the container exits.
#
# Tabs round-trip through \037 (Unit Separator) before `read` because bash
# treats IFS=$'\t' as whitespace and collapses runs of it — which would lose
# empty middle fields like an unset label.
cmd_list() {
    local vol_fmt='{{.Label "maudebox.project"}}\t{{.Label "maudebox.instance"}}\t{{.Label "maudebox.ephemeral"}}'
    local ps_fmt='{{.Label "maudebox.project"}}\t{{.ID}}\t{{.Label "maudebox.instance"}}\t{{.Label "maudebox.ephemeral"}}'
    local running volumes
    running="$(docker ps --filter label=maudebox.instance --format "$ps_fmt" | tr '\t' '\037')"
    volumes="$(docker volume ls --filter name=maudebox-overlay- --format "$vol_fmt" | tr '\t' '\037')"

    # Union of project keys from both sources, deduped.
    local projects
    projects="$( {
        printf '%s\n' "$volumes"
        printf '%s\n' "$running"
    } | awk -F'\037' '$1 != "" {print $1}' | sort -u )"

    {
        printf 'ID\tSTATUS\tINSTANCE\tEPHEMERAL\tOVERLAYS\tPATH\n'
        local project vol_sample run_sample _proj instance ephemeral id status state_dir overlays
        while IFS= read -r project; do
            [ -z "$project" ] && continue
            instance=""; ephemeral=""; id=""

            # Volume labels are authoritative when available — they survive
            # container exit, so a stopped instance still has full metadata.
            vol_sample="$(printf '%s\n' "$volumes" | awk -F'\037' -v p="$project" '$1==p {print; exit}')"
            if [ -n "$vol_sample" ]; then
                IFS=$'\037' read -r _proj instance ephemeral <<<"$vol_sample"
            fi

            # Container labels fill in when there's no volume (running
            # instance with no overlay) and supply the running container ID.
            run_sample="$(printf '%s\n' "$running" | awk -F'\037' -v p="$project" '$1==p {print; exit}')"
            if [ -n "$run_sample" ]; then
                local _r_proj r_instance r_ephemeral
                IFS=$'\037' read -r _r_proj id r_instance r_ephemeral <<<"$run_sample"
                : "${instance:=$r_instance}"
                : "${ephemeral:=$r_ephemeral}"
            fi

            # Count overlay volumes for this project (0 when running with no
            # overlay configured).
            overlays="$(printf '%s\n' "$volumes" | awk -F'\037' -v p="$project" '$1==p' | wc -l | tr -d ' ')"

            if [ -n "$id" ]; then
                status="running"
            else
                id="-"
                status="stopped"
            fi

            # Surface ephemeral-with-keep-set as non-ephemeral, since at that
            # point the workspace will outlive the container.
            if [ "$ephemeral" = "true" ]; then
                state_dir="$(compute_state_dir "$project")"
                [ -e "$state_dir/keep" ] && ephemeral="false"
            fi

            printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$status" "${instance:-?}" "${ephemeral:--}" "$overlays" "$project"
        done <<< "$projects"
    } | column -t -s $'\t'
}

# ── `maudebox mount {add|list|rm}` ───────────────────────────────────────────
# Manage the user config file by reading the current `mounts` list, mutating
# it, and rewriting only that array — comments and any other TOML content
# elsewhere in the file are preserved verbatim.

# Emit the `mounts = [...]` block to stdout from the caller's `specs` array
# (visible via bash dynamic scope). Non-empty → multi-line for readability,
# empty → single-line `mounts = []`.
emit_mounts_block() {
    if [ "${#specs[@]}" -eq 0 ]; then
        echo "mounts = []"
    else
        echo "mounts = ["
        local s
        for s in "${specs[@]}"; do
            printf '    "%s",\n' "$s"
        done
        echo "]"
    fi
}

# Write `specs[@]` back to the user config, replacing only the `mounts = [...]`
# block and leaving every other line of the file (comments, other TOML
# keys, blank lines) untouched. The block is emitted as a multi-line array
# when non-empty so `mount list` reads stably.
write_mounts_config() {
    # `"$@"` (no braces) is the bash-3.2-safe form under set -u when there
    # are no positional args; `"${@}"` errors with "@: unbound variable".
    local -a specs=( "$@" )
    local tmp="${MAUDEBOX_CONFIG}.tmp.$$"
    mkdir -p "$(dirname "$MAUDEBOX_CONFIG")"

    if [ ! -e "$MAUDEBOX_CONFIG" ]; then
        emit_mounts_block > "$tmp"
        mv "$tmp" "$MAUDEBOX_CONFIG"
        return
    fi

    # Existing file: stream lines through, replace just the mounts
    # assignment range, leave everything else as-is. Multi-line array
    # support: once we hit `mounts = [`, swallow input lines until the
    # closing `]`. Single-line array (`mounts = ["a"]`) ends on the same
    # line. If no mounts assignment exists at all, append at the end.
    local line in_block=false replaced=false
    {
        while IFS= read -r line || [ -n "$line" ]; do
            if ! $in_block && [[ "$line" =~ ^[[:space:]]*mounts[[:space:]]*=[[:space:]]*\[ ]]; then
                emit_mounts_block
                replaced=true
                if [[ "$line" == *"]"* ]]; then
                    continue   # single-line array: done
                fi
                in_block=true
                continue
            fi
            if $in_block; then
                if [[ "$line" == *"]"* ]]; then
                    in_block=false
                fi
                continue
            fi
            printf '%s\n' "$line"
        done < "$MAUDEBOX_CONFIG"
        if ! $replaced; then
            emit_mounts_block
        fi
    } > "$tmp"
    mv "$tmp" "$MAUDEBOX_CONFIG"
}

cmd_mount() {
    local action="${1:-}"
    [ -n "$action" ] || { echo "maudebox mount: action required (add|list|rm)" >&2; exit 1; }
    shift

    # Read current specs into an array.
    local -a current=()
    while IFS= read -r _spec; do
        [ -n "$_spec" ] && current+=( "$_spec" )
    done < <(parse_toml_mounts "$MAUDEBOX_CONFIG")

    case "$action" in
        list)
            local s
            for s in "${current[@]+"${current[@]}"}"; do
                printf '%s\n' "$s"
            done
            ;;
        add)
            local spec="${1:-}"
            [ -n "$spec" ] || { echo "maudebox mount add: SPEC required" >&2; exit 1; }
            local s
            for s in "${current[@]+"${current[@]}"}"; do
                if [ "$s" = "$spec" ]; then
                    echo "Already in the user config: $spec"
                    exit 0
                fi
            done
            current+=( "$spec" )
            write_mounts_config "${current[@]}"
            echo "Added: $spec"
            ;;
        rm)
            local spec="${1:-}"
            [ -n "$spec" ] || { echo "maudebox mount rm: SPEC required" >&2; exit 1; }
            local -a kept=()
            local found=false
            local s
            for s in "${current[@]+"${current[@]}"}"; do
                if [ "$s" = "$spec" ] && ! $found; then
                    found=true
                else
                    kept+=( "$s" )
                fi
            done
            if ! $found; then
                echo "Not in the user config: $spec" >&2
                exit 1
            fi
            write_mounts_config "${kept[@]+"${kept[@]}"}"
            echo "Removed: $spec"
            ;;
        *)
            echo "maudebox mount: unknown action '$action' (expected add|list|rm)" >&2
            exit 1
            ;;
    esac
}

# ── `maudebox keep <id-or-name>` ─────────────────────────────────────────────
# Find a running ephemeral container by container ID, instance basename, or
# the original `maudebox new <name>` name, then drop the `keep` flag in its
# state dir. A no-op for non-ephemeral instances.
cmd_keep() {
    local target="${1:-}"
    [ -n "$target" ] || { echo "maudebox keep: <id-or-name> required" >&2; exit 1; }

    local fmt='{{.ID}}\t{{.Label "maudebox.instance"}}\t{{.Label "maudebox.ephemeral-name"}}\t{{.Label "maudebox.ephemeral"}}\t{{.Label "maudebox.state-dir"}}\t{{.Label "maudebox.project"}}'
    local matches
    matches="$(docker ps --filter label=maudebox.instance --format "$fmt" \
        | awk -F'\t' -v t="$target" '$1==t || $2==t || $3==t')"

    local count
    count="$(printf '%s' "$matches" | grep -c . || true)"
    if [ "$count" -eq 0 ]; then
        echo "No running maudebox container matches '$target'." >&2
        exit 1
    elif [ "$count" -gt 1 ]; then
        echo "Multiple running maudebox containers match '$target':" >&2
        printf '%s\n' "$matches" | awk -F'\t' '{printf "  %s  %s  (%s)\n", $1, $2, $6}' >&2
        exit 1
    fi

    local id instance ename ephemeral state_dir _project
    # See the cmd_list comment: IFS=$'\t' collapses empty middle fields (e.g.
    # an unset ephemeral-name on a non-ephemeral container would shift the
    # rest one position left). Use \037 so each delimiter stays distinct.
    IFS=$'\037' read -r id instance ename ephemeral state_dir _project \
        <<<"$(printf '%s' "$matches" | tr '\t' '\037')"

    if [ "$ephemeral" != "true" ]; then
        echo "Instance '$instance' is not ephemeral; nothing to keep."
        exit 0
    fi
    if [ -z "$state_dir" ]; then
        echo "Instance '$instance' was launched by an older version of maudebox that doesn't support 'keep'; restart the container to enable it." >&2
        exit 1
    fi

    mkdir -p "$state_dir"
    touch "$state_dir/keep"
    echo "Marked '$instance' to keep — workspace and overlay volume will survive when the container exits."
}

# ── parse flags ───────────────────────────────────────────────────────────────
# --ephemeral-name is internal: cmd_new passes it on the recursive invocation
# so the inner run can label its container as ephemeral. Intentionally not
# advertised in --help.
while [[ "${1:-}" == --* || "${1:-}" == -h ]]; do
    case "$1" in
        -h|--help)        usage; exit 0 ;;
        --clean)          CLEAN=true;             shift ;;
        --tag)            IMAGE_NAME="$2";        shift 2 ;;
        --memory-from)    MEMORY_FROM="$2";       shift 2 ;;
        --mount)          EXTRA_MOUNTS+=( "$2" ); shift 2 ;;
        --ephemeral-name) EPHEMERAL_NAME="$2";    shift 2 ;;
        *) echo "Unknown option: $1" >&2; usage >&2; exit 1 ;;
    esac
done

# ── subcommand dispatch ───────────────────────────────────────────────────────
case "${1:-}" in
    new)   shift; cmd_new "$@" ;;
    list)  shift; cmd_list "$@";  exit ;;
    keep)  shift; cmd_keep "$@";  exit ;;
    mount) shift; cmd_mount "$@"; exit ;;
esac

PROJECT_DIR="$(realpath "${1:-.}")"
shift || true   # remaining args become the container command (default: bash)

# ── detect base repo for jj workspaces / git worktrees ────────────────────────
# A jj workspace stores the absolute or relative path to the *main* repo's
# .jj/repo directory inside <workspace>/.jj/repo (a regular file). A git
# worktree stores `gitdir: <abs-path>` in <worktree>/.git (also a regular
# file). In both cases the worktree's own metadata references an absolute
# host path that won't exist inside the container unless we bind-mount the
# base repo at the same path. detect_vcs_base prints that base path (the
# main repo's working tree, not its .jj/.git dir) or nothing if the project
# isn't a worktree/workspace.
detect_vcs_base() {
    local dir="$1"
    [ -d "$dir" ] || return 0

    if [ -f "$dir/.jj/repo" ]; then
        local content target base
        content="$(cat "$dir/.jj/repo")"
        content="${content%$'\n'}"
        if [[ "$content" == /* ]]; then
            target="$content"
        else
            target="$(cd "$dir/.jj" 2>/dev/null && readlink -f "$content" 2>/dev/null)" || true
        fi
        # target is <main>/.jj/repo; the working tree is two levels up.
        base="${target%/.jj/repo}"
        if [ -n "$target" ] && [ "$base" != "$target" ] && [ "$base" != "$dir" ]; then
            echo "$base"
            return
        fi
    fi

    if [ -f "$dir/.git" ]; then
        local gitdir base
        gitdir="$(grep -m1 '^gitdir:' "$dir/.git" | sed 's|^gitdir: *||')"
        if [[ "$gitdir" != /* ]]; then
            gitdir="$(cd "$dir" 2>/dev/null && readlink -f "$gitdir" 2>/dev/null)" || true
        fi
        # gitdir is typically <main>/.git/worktrees/<name>, sometimes <main>/.git.
        base="${gitdir%/.git/worktrees/*}"
        [ "$base" = "$gitdir" ] && base="${gitdir%/.git}"
        if [ -n "$gitdir" ] && [ "$base" != "$gitdir" ] && [ "$base" != "$dir" ]; then
            echo "$base"
            return
        fi
    fi
}

VCS_BASE="$(detect_vcs_base "$PROJECT_DIR")"

# ── --clean ───────────────────────────────────────────────────────────────────
# Remove every overlay volume tied to this project. We filter by the
# `maudebox.project` label rather than the volume name pattern because a
# project can own multiple overlay volumes (one per overlay target) and the
# label is the canonical link.
if $CLEAN; then
    volumes="$(docker volume ls --filter label=maudebox.project="$PROJECT_DIR" --format '{{.Name}}')"
    if [ -z "$volumes" ]; then
        echo "No overlay volumes found for: $PROJECT_DIR"
    else
        while IFS= read -r v; do
            docker volume rm "$v" > /dev/null
            echo "Removed volume: $v"
        done <<< "$volumes"
    fi
    exit 0
fi

# ── Persistent state: maudebox-state volume + read-only host overlays ────────
# maudebox-state holds writable state shared across all containers/worktrees.
# A single volume hosts two isolated subtrees, mounted into the container at
# the canonical paths each tool expects:
#   claude/  → /root/.claude        (Claude login, plugin caches)
#   gh/      → /root/.config/gh     (gh auth, config)
# Using subpath mounts keeps the two trees from mixing on disk while sharing a
# single Docker volume. volume-subpath mounts fail if the subpath doesn't
# exist, so we mkdir both up front via a throwaway container — idempotent and
# cheap (~50ms). On top of the claude subtree, specific files from the host's
# ~/.claude/ are bind-mounted read-only so the user's global Claude config
# (CLAUDE.md, settings, agents, commands, plugins) comes from the host.
# Host-path-keyed entries (projects/, todos/, statsig/, shell-snapshots/) are
# intentionally left out.
STATE_VOLUME="maudebox-state"
docker volume create "$STATE_VOLUME" > /dev/null
docker run --rm --entrypoint mkdir -v "${STATE_VOLUME}:/v" "$IMAGE_NAME" -p /v/claude /v/gh

CLAUDE_MOUNTS=(
    --mount "type=volume,src=${STATE_VOLUME},dst=/root/.claude,volume-subpath=claude"
    --mount "type=volume,src=${STATE_VOLUME},dst=/root/.config/gh,volume-subpath=gh"
)
HOST_CLAUDE_DIR="$HOME/.claude"
for path in CLAUDE.md settings.json agents commands plugins; do
    if [ -e "$HOST_CLAUDE_DIR/$path" ]; then
        CLAUDE_MOUNTS+=( -v "$HOST_CLAUDE_DIR/$path:/root/.claude/$path:ro" )
    fi
done

# Claude's auto-memory lives at ~/.claude/projects/<encoded-cwd>/memory/, where
# the encoding replaces '/' and '.' in the canonical cwd with '-'. Inside the
# container the project is bind-mounted at its host path, so cwd canonicalizes
# to the same string — meaning host and container normally agree on the key.
# Bind-mount just that one subdir (read-write) so memories written inside the
# container land in the host's ~/.claude/projects/<key>/memory/ and are visible
# to host-side Claude. The rest of projects/<key>/ (session logs, etc.) stays
# in the named volume, consistent with the broader exclusion of projects/.
#
# --memory-from breaks the host/container symmetry: the container target is
# still keyed by PROJECT_DIR (Claude Code derives it from cwd inside the
# container), but the host source is keyed by the override path. `maudebox new`
# uses this so an ephemeral workspace shares its parent project's memory.
PROJECT_KEY="${PROJECT_DIR//\//-}"
PROJECT_KEY="${PROJECT_KEY//./-}"
MEMORY_SOURCE_DIR="${MEMORY_FROM:-$PROJECT_DIR}"
MEMORY_SOURCE_KEY="${MEMORY_SOURCE_DIR//\//-}"
MEMORY_SOURCE_KEY="${MEMORY_SOURCE_KEY//./-}"
HOST_MEMORY_DIR="$HOST_CLAUDE_DIR/projects/$MEMORY_SOURCE_KEY/memory"
mkdir -p "$HOST_MEMORY_DIR"
CLAUDE_MOUNTS+=( -v "$HOST_MEMORY_DIR:/root/.claude/projects/$PROJECT_KEY/memory" )

# ── host git/jj config (read-only) ────────────────────────────────────────────
# Pick up the user's identity, aliases, ignore rules, and jj revset aliases
# (e.g. closest_bookmark) without importing host-local state. We deliberately
# skip ~/.config/jj/repos/ (per-repo cache, host paths) and credential/SSH
# files. Container-incompatible settings like commit.gpgsign are forced off
# in the Dockerfile via GIT_CONFIG_* env vars.
VCS_CONFIG_MOUNTS=()
[ -e "$HOME/.gitconfig" ]               && VCS_CONFIG_MOUNTS+=( -v "$HOME/.gitconfig:/root/.gitconfig:ro" )
[ -d "$HOME/.config/git" ]              && VCS_CONFIG_MOUNTS+=( -v "$HOME/.config/git:/root/.config/git:ro" )
[ -e "$HOME/.config/jj/config.toml" ]   && VCS_CONFIG_MOUNTS+=( -v "$HOME/.config/jj/config.toml:/root/.config/jj/config.toml:ro" )

# ── extra user-defined mounts (--mount and config) ───────────────────────────
# CLI mounts already collected in EXTRA_MOUNTS. Merge in config-file mounts
# (this side reads the config rather than cmd_new so the recursive `maudebox
# new` invocation doesn't double-apply the file when forwarding CLI specs).
while IFS= read -r _spec; do
    [ -n "$_spec" ] && EXTRA_MOUNTS+=( "$_spec" )
done < <(parse_toml_mounts "$MAUDEBOX_CONFIG")
EXTRA_MOUNT_ARGS=()
for _spec in "${EXTRA_MOUNTS[@]+"${EXTRA_MOUNTS[@]}"}"; do
    build_mount_arg EXTRA_MOUNT_ARGS "$_spec"
done

# ── run ───────────────────────────────────────────────────────────────────────
# The same maudebox.* labels go on both the overlay volume and the container.
# Volumes outlive containers, so labelling the volume is what lets `maudebox
# list` recover the project path and ephemeral status for stopped instances.
# (Pre-existing volumes from before this change won't have labels — they show
# in the list with derived basename and empty path; a `--clean` + re-run
# re-creates them with labels.) EPHEMERAL_NAME is set only when cmd_new
# spawned us recursively; in that case we also set up a per-instance state
# dir on the host and bind-mount it at /run/maudebox/ so `maudebox-keep`
# (in-container) and `maudebox keep` (host) can drop the keep flag the
# cleanup trap reads after exit.
INSTANCE_NAME="$(basename "$PROJECT_DIR")"
LABELS=(
    --label "maudebox.instance=$INSTANCE_NAME"
    --label "maudebox.project=$PROJECT_DIR"
)
EPHEMERAL_MOUNT=()
if [ -n "$EPHEMERAL_NAME" ]; then
    STATE_DIR="$(compute_state_dir "$PROJECT_DIR")"
    mkdir -p "$STATE_DIR"
    LABELS+=(
        --label "maudebox.ephemeral=true"
        --label "maudebox.ephemeral-name=$EPHEMERAL_NAME"
        --label "maudebox.state-dir=$STATE_DIR"
    )
    EPHEMERAL_MOUNT=( -v "$STATE_DIR:/run/maudebox" )
else
    LABELS+=( --label "maudebox.ephemeral=false" )
fi

# For each overlay mount spec, materialize a per-worktree+per-target upper-
# layer volume (labeled the same as the container, plus a per-volume
# `maudebox.overlay-target` label so `--clean` can find it later) and
# assemble:
#   - one `-v <host>:/maudebox/overlay-N/lower:ro` for each lowerdir,
#   - one `-v <volume>:/maudebox/overlay-N/upper` for each upperdir,
#   - one MAUDEBOX_OVERLAYS env var: newline-separated `lower:upper:target`
#     triples for the entrypoint to iterate over and mount.
# No overlay spec → no volumes created → `--clean` is a silent no-op.
OVERLAY_ARGS=()
OVERLAY_ENV=()
overlay_count="${#OVERLAY_TARGETS[@]}"
if [ "$overlay_count" -gt 0 ]; then
    overlay_env_val=""
    for ((i=0; i<overlay_count; i++)); do
        n=$((i + 1))
        src="${OVERLAY_HOSTS[$i]}"
        dst="${OVERLAY_TARGETS[$i]}"
        vol="$(compute_overlay_volume "$PROJECT_DIR" "$dst")"
        docker volume create "${LABELS[@]}" \
            --label "maudebox.overlay-target=$dst" \
            "$vol" > /dev/null
        OVERLAY_ARGS+=(
            -v "$src:/maudebox/overlay-$n/lower:ro"
            -v "$vol:/maudebox/overlay-$n/upper"
        )
        overlay_env_val+="/maudebox/overlay-$n/lower:/maudebox/overlay-$n/upper:$dst"$'\n'
    done
    OVERLAY_ENV=( -e "MAUDEBOX_OVERLAYS=$overlay_env_val" )
fi

# Mount the project (and its base repo, if it's a jj/git worktree) at their
# host paths inside the container so absolute path references in the worktree
# metadata still resolve. The entrypoint adds a /root/<basename> symlink to
# the project for short cd's.
PROJECT_MOUNTS=( -v "${PROJECT_DIR}:${PROJECT_DIR}" )
if [ -n "$VCS_BASE" ] && [ "$VCS_BASE" != "$PROJECT_DIR" ]; then
    PROJECT_MOUNTS+=( -v "${VCS_BASE}:${VCS_BASE}" )
fi

# Linux Docker passes UIDs through bind mounts literally: a root-in-container
# write becomes a root-on-host file. macOS/OrbStack root-squashes virtiofs and
# maps container-root↔host-user, so root-in-container writes show up as the
# host user. To avoid root-owned files in the host project tree on Linux, pass
# the host UID/GID and let the entrypoint drop privileges before exec'ing the
# user command. On macOS we leave them unset so the container keeps running as
# root (overlay copy-up depends on it when an overlay mount is in use; see
# CLAUDE.md).
USER_ENV=()
if [[ "$(uname -s)" == "Linux" ]]; then
    USER_ENV=( -e "HOST_UID=$(id -u)" -e "HOST_GID=$(id -g)" )
fi

echo "Image    : $IMAGE_NAME"
echo "Worktree : $PROJECT_DIR"
[ -n "$VCS_BASE" ] && [ "$VCS_BASE" != "$PROJECT_DIR" ] && echo "VCS base : $VCS_BASE"
for ((i=0; i<${#OVERLAY_TARGETS[@]}; i++)); do
    echo "Overlay  : ${OVERLAY_HOSTS[$i]} -> ${OVERLAY_TARGETS[$i]}"
done

# `"${arr[@]+"${arr[@]}"}"` is the bash-3.2-safe form for expanding a possibly-
# empty array under `set -u` — plain `"${arr[@]}"` errors on macOS bash 3.2
# when the array is empty. USER_ENV is empty on macOS; EPHEMERAL_MOUNT and
# OVERLAY_* are empty when the corresponding feature isn't requested.
docker run --rm -it \
    --cap-add SYS_ADMIN \
    --security-opt apparmor=unconfined \
    -e "HOST_PROJECT_DIR=$PROJECT_DIR" \
    -e "MAUDEBOX_INSTANCE=$INSTANCE_NAME" \
    "${USER_ENV[@]+"${USER_ENV[@]}"}" \
    "${OVERLAY_ENV[@]+"${OVERLAY_ENV[@]}"}" \
    "${LABELS[@]}" \
    "${OVERLAY_ARGS[@]+"${OVERLAY_ARGS[@]}"}" \
    "${EPHEMERAL_MOUNT[@]+"${EPHEMERAL_MOUNT[@]}"}" \
    "${PROJECT_MOUNTS[@]}" \
    "${CLAUDE_MOUNTS[@]}" \
    "${VCS_CONFIG_MOUNTS[@]}" \
    "${EXTRA_MOUNT_ARGS[@]+"${EXTRA_MOUNT_ARGS[@]}"}" \
    "$IMAGE_NAME" \
    "$@"